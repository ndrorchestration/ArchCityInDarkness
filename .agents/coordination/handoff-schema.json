{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACID-HIP-001 proposed task handoff",
  "description": "Formalizes the task portion of .agents/AGENTS.md for this bounded pilot. This is a proposed data contract, not permission enforcement, runtime authentication, implementation/review evidence, or pilot approval. Implementation and review output contracts remain in .agents/AGENTS.md.",
  "type": "object",
  "required": [
    "task_id",
    "objective",
    "owner",
    "base_sha",
    "allowed_paths",
    "forbidden_actions",
    "acceptance_checks",
    "dependencies",
    "budget_caps",
    "reviewer"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "enum": [
        "ACID-HIP-001"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner": {
      "type": "string",
      "enum": [
        "Hermes"
      ]
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "enum": [
        "446f5547d11d7b549f24888c5e44e163202a2424"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          ".agents/coordination/"
        ]
      }
    },
    "forbidden_actions": {
      "description": "Declared prohibitions; validation does not enforce shell or Git permissions. The authoritative task remains binding.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "git",
          "python"
        ]
      }
    },
    "budget_caps": {
      "type": "object",
      "required": [
        "max_cost_usd"
      ],
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 0
        }
      }
    },
    "reviewer": {
      "type": "string",
      "enum": [
        "Herald"
      ]
    }
  }
}
