{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACID-HIP v0.1 task handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "owner",
    "reviewer",
    "repository",
    "base_sha",
    "allowed_paths",
    "objective",
    "acceptance_criteria",
    "max_cost_usd"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^ACID-HIP-[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "TODO",
        "IN_PROGRESS",
        "DONE",
        "BLOCKED",
        "NEEDS_HERALD",
        "NEEDS_ENDER"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "output"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "output": {
            "type": "string"
          }
        }
      }
    }
  }
}
